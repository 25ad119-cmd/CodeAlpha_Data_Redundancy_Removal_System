# Intent structure maps user inputs to standardized corporate responses
KNOWLEDGE_BASE = [
    {
        "intent": "greeting",
        "patterns": ["hi", "hello", "hey there", "is anyone there", "good day"],
        "responses": ["Hello! Welcome to Cloud Services. How can I assist you today?", "Hi there! What can I help you with?"]
    },
    {
        "intent": "pricing",
        "patterns": ["how much does it cost", "what are your prices", "pricing plans", "subscription fees", "cost"],
        "responses": ["Our cloud tiers start at $0/month for hobbyists, $15/month for Professionals, and custom pricing for Enterprise architectures."]
    },
    {
        "intent": "bus_pass_support",
        "patterns": ["how to book a bus pass", "ticket booking issues", "i want to buy a pass", "bus ticket cancel"],
        "responses": ["You can manage passes instantly via our Cloud-Based Bus Pass portal. Simply enter your route and process payment safely!"]
    },
    {
        "intent": "security",
        "patterns": ["is my data safe", "sql injection prevention", "are credentials encrypted", "data leaks"],
        "responses": ["Security is our priority. We deploy double-layer protocols including parameterized queries and AES-256 data encryption at rest."]
    },
    {
        "intent": "goodbye",
        "patterns": ["bye", "see you later", "goodbye", "thanks", "thank you"],
        "responses": ["Happy to help! Have a wonderful day!", "Thank you for contacting us. Goodbye!"]
    }
]

# Flatten patterns to train the vectorizer matrix
all_patterns = []
pattern_to_response_map = []

for item in KNOWLEDGE_BASE:
    for pattern in item["patterns"]:
        all_patterns.append(pattern.lower())
        pattern_to_response_map.append(item["responses"][0]) # Default to primary response

# Initialize and fit TF-IDF vectorizer model
vectorizer = TfidfVectorizer()
tfidf_matrix = vectorizer.fit_transform(all_patterns)

def generate_bot_response(user_message: str) -> str:
    """Calculates cosine similarity to match input to the best commercial intent."""
    user_message = user_message.lower().strip()
    if not user_message:
        return "I didn't catch that. Could you please rephrase?"

    # Vectorize the incoming user statement
    user_vector = vectorizer.transform([user_message])
    
    # Calculate similarity score against all stored patterns
    similarities = cosine_similarity(user_vector, tfidf_matrix).flatten()
    best_match_idx = similarities.argsort()[-1] # Fetch index of maximum match
    
    # Confidence threshold guardrail (0.2) to prevent completely mismatched answers
    if similarities[best_match_idx] < 0.2:
        return "I am trained exclusively for commercial operations. Can you please ask about pricing, data security, or pass bookings?"
        
    return pattern_to_response_map[best_match_idx]


